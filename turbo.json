{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "BACKEND_BASE_URL",
    "BACKEND_URL",
    "BFF_ALLOWED_ORIGINS",
    "BFF_ATTESTATION_SECRET",
    "BFF_URL",
    "NEXT_PUBLIC_BFF_URL",
    "NODE_ENV",
    "ONIMISERA_BACKEND_URL",
    "REVALIDATE_SECRET"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
